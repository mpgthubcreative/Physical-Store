# Buddy Patches — required Netlify environment variables.
# Copy the NAMES below into Netlify's site settings → Environment variables.
# Never commit real values. This file only documents shape/placeholders.
#
# Buddy must use its own values here — never Luna Shop's project, bucket,
# API key, or sender identity.

# --- Firebase Admin (Netlify Functions only — never sent to the browser) ---
# Paste the full JSON contents of a Buddy Firebase service account key,
# as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"buddy-shop-45fc4","private_key":"REPLACE_ME"}
FIREBASE_STORAGE_BUCKET=buddy-shop-45fc4.firebasestorage.app

# --- Resend + transactional email (Phase 5E) ---
RESEND_API_KEY=your_buddy_resend_api_key_here
EMAIL_FROM=Buddy Patches <hello@buddypatches.ph>
ADMIN_NOTIFICATION_EMAIL=your_buddy_admin_email@example.com
SITE_URL=https://buddypatches.ph

# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs every email access
# token (order.html links inside emails). Rotating this instantly
# invalidates every outstanding email-issued link — the emergency lever if
# one is ever suspected leaked. Never reuse EMAIL_TOKEN_SECRET as
# RATE_LIMIT_SECRET or vice versa — independent rotation, independent blast
# radius.
EMAIL_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# 32+ random bytes, e.g. `openssl rand -hex 32`. HMAC key for the public
# Events & Parties inquiry endpoint's IP/email rate-limit counters — never
# the same value as EMAIL_TOKEN_SECRET.
RATE_LIMIT_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Optional. When SET, every outgoing email in QA mode redirects here
# instead of the real recipient. Required to switch settings/email.mode to
# 'qa'; must be REMOVED (and the site redeployed) before 'live' mode is
# allowed — admin-save-email-settings.js structurally refuses 'live' while
# this is still set.
#EMAIL_QA_OVERRIDE_RECIPIENT=you@example.com

# Optional, TESTING ONLY. Overrides the Resend idempotency-safe window
# used by the scheduled processor's stale-lease/crash-recovery logic — but
# only DOWNWARD: production code hard-caps this at 12 hours regardless of
# what this is set to, so it can never accidentally weaken duplicate-send
# protection. Leave unset in production.
#EMAIL_IDEMPOTENCY_WINDOW_MS_TEST_OVERRIDE=5000
